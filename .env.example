# Copie ce fichier en .env et remplis-le pour activer la connexion Google + la sauvegarde.
# Sans ces valeurs, le jeu fonctionne en mode invité (rien n'est sauvegardé).

# Client (exposé au navigateur) — Supabase › Project Settings › API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Serveur (secret, ne jamais l'exposer au client)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Migrations (npm run db:migrate) — Supabase › Project Settings › Database › Connection string › URI
# (mot de passe de la base inclus ; secret, ne jamais l'exposer). Entre guillemets, et caractères spéciaux du
# mot de passe encodés (# → %23, & → %26, ' → %27, / → %2F, % → %25) — ou un mot de passe sans caractères spéciaux.
DATABASE_URL=""
