# Copie ce fichier en .env et remplis-le pour activer la connexion Google + la sauvegarde.
# Sans ces valeurs, le jeu fonctionne en mode invité (rien n'est sauvegardé).

# Client (exposé au navigateur) — Supabase › Project Settings › API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Serveur (secret, ne jamais l'exposer au client)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Migrations (npm run db:migrate) — Supabase › Project Settings › Database › Connection string › URI
# (mot de passe de la base inclus ; secret, ne jamais l'exposer). Entre guillemets, et caractères spéciaux du
# mot de passe encodés (# → %23, & → %26, ' → %27, / → %2F, % → %25) — ou un mot de passe sans caractères spéciaux.
DATABASE_URL=""

# Environnement : vide (ou production) pour la prod et le local, « staging » sur le staging (où la variable est
# réglée dans Coolify, pas dans un .env). Figée dans le build du client : badge STAGING, titre de l'onglet et
# présence du panneau de triche. Voir docs/ENVIRONNEMENTS.md.
VITE_FANGLEAF_ENV=

# Triches (F9) quand NODE_ENV=production : « 1 » sur le staging seulement. Variable du serveur seul, comme
# ALLOW_GUESTS ; la production ne la déclare jamais. En développement, les triches sont déjà ouvertes.
ALLOW_CHEATS=
